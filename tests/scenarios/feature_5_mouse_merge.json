{
  "name": "Feature 5: mouse merge preview, level mismatch swap and battle",
  "scene": "res://tests/scenes/fixed_battlefield_game.tscn",
  "keep_running": true,
  "steps": [
    { "set": { "path": "SummonManager", "props": { "pool": "res://tests/resources/archer_only_pool.tres" } } },
    { "eval": "get_node('WaveManager/SpawnTimer').stop()" },
    { "set": { "path": "World/Enemies/Enemy", "props": { "move_speed": 0, "current_health": 10000, "max_health": 10000 } } },
    { "input": [{ "wait": 0.15 }, { "click_node": "World/Tower/SummonButton" }, { "wait": 0.1 }, { "click_node": "World/Tower/SummonButton" }, { "wait": 0.1 }] },
    { "eval": "set_meta('survivor', get_node('World/Slots/Slot2').unit.get_instance_id())" },
    { "input": [{ "drag": [[180, 360], [540, 360]], "seconds": 0.35 }] },
    { "assert": "get_node('World/Slots/Slot1').is_empty() and get_node('World/Slots/Slot2').unit.get_instance_id() == get_meta('survivor') and get_node('World/Slots/Slot2').unit.stats.level == 2 and get_node('SummonManager').occupied_count() == 1 and get_node('SummonManager').mana == 55 and get_node('SummonManager').current_cost() == 30" },
    { "input": [{ "click_node": "World/Tower/SummonButton" }] },
    { "eval": "set_meta('green', get_node('World/Slots/Slot1').unit.get_instance_id())" },
    { "input": [{ "drag": [[180, 360], [540, 360]], "seconds": 0.35 }] },
    { "assert": "get_node('World/Slots/Slot1').unit.get_instance_id() == get_meta('survivor') and get_node('World/Slots/Slot2').unit.get_instance_id() == get_meta('green') and get_node('World/Slots/Slot1').unit.stats.level == 2 and get_node('World/Slots/Slot2').unit.stats.level == 1" },
    { "input": [{ "drag": [[180, 360], [360, 700]], "seconds": 0.3 }, { "drag": [[540, 360], [360, 1220]], "seconds": 0.3 }] },
    { "assert": "get_node('SummonManager').occupied_count() == 2 and get_node('SummonManager').mana == 25 and get_node('SummonManager').current_cost() == 35 and not get_node('World/DragController/Preview').visible" },
    { "wait": 5 },
    { "assert": "state == 0 and get_node('World/Tower').current_health == 100" },
    { "assert_no_errors": true }
  ]
}
