{
  "name": "Feature 2: automatic Archer defense",
  "scene": "res://scenes/game.tscn",
  "keep_running": true,
  "steps": [
    {
      "call": { "path": "SummonManager", "method": "try_summon" }
    },
    {
      "assert": "get_node('World/Tower').current_health == 100"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 1 and get_node('World/Enemies').get_child(0).current_health == 20"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 1 and get_node('World/Enemies').get_child(0).current_health == 10"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 0"
    },
    {
      "assert": "get_node('World/Tower').current_health == 100 and not get_node('SpawnTimer').is_stopped()"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 1"
    },
    {
      "assert": "get_node('World/Enemies').get_child(0).current_health == 30"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 1 and get_node('World/Enemies').get_child(0).current_health == 20"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 1 and get_node('World/Enemies').get_child(0).current_health == 10"
    },
    {
      "wait_for": "get_node('World/Enemies').get_child_count() == 0"
    },
    {
      "assert": "state == 0 and get_node('World/Tower').current_health == 100 and get_node('World/Projectiles').get_child_count() == 0 and not get_node('Interface/Hud/GameOverOverlay').visible"
    },
    {
      "assert_no_errors": true
    }
  ]
}
