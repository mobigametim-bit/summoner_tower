{
  "name": "Feature 5: atomic merge, levels, projectiles, touch and restart",
  "scene": "res://tests/scenes/feature_5_merge_test.tscn",
  "keep_running": true,
  "steps": [
    { "set": { "path": "Game/SummonManager", "props": { "pool": "res://tests/resources/archer_only_pool.tres" } } },
    { "call": { "path": "", "method": "run_checks" } },
    { "assert": "get_meta('feature5_checks').passed and get_meta('feature5_checks').levels == 5 and get_node('Game').state == 1" },
    { "input": [{ "click_node": "Game/Interface/Hud/GameOverOverlay/Center/Panel/Stack/Actions/RestartButton" }, { "wait": 0.2 }] },
    { "set": { "path": "Game/SummonManager", "props": { "pool": "res://tests/resources/archer_only_pool.tres" } } },
    { "eval": "get_node('Game/WaveManager/SpawnTimer').stop()" },
    { "set": { "path": "Game/World/Enemies/Enemy", "props": { "move_speed": 0, "current_health": 10000, "max_health": 10000 } } },
    { "assert": "get_node('Game').state == 0 and get_node('Game/SummonManager').mana == 100 and get_node('Game/SummonManager').current_cost() == 20 and get_node('Game/SummonManager').occupied_count() == 0 and get_node('Game/World/Projectiles').get_child_count() == 0" },
    { "input": [{ "click_node": "Game/World/Tower/SummonButton" }, { "click_node": "Game/World/Tower/SummonButton" }, { "drag": [[180, 360], [540, 360]], "seconds": 0.35 }] },
    { "assert": "get_node('Game/World/Slots/Slot1').is_empty() and get_node('Game/World/Slots/Slot2').unit.stats.level == 2 and get_node('Game/SummonManager').occupied_count() == 1 and get_node('Game/SummonManager').mana == 55 and get_node('Game/SummonManager').current_cost() == 30" },
    { "assert_no_errors": true }
  ]
}
